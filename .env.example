# For local development with Docker MySQL
APP_ID=dev-app-id
APP_SECRET=dev-app-secret-change-in-production
DATABASE_URL=mysql://swarm:swarmpass@localhost:3306/swarm
# Optional MySQL read-replica (Phase 3). Point read-heavy browse/report
# queries at a replica. Leave empty to use DATABASE_URL for all queries.
DATABASE_READ_URL=
VITE_APP_ID=dev-app-id

# ─── Foundation Sprint (F0) optional infrastructure ───
# Redis: queue + pub/sub backends. Optional — without it the app runs with
# in-memory fallbacks (single node only). docker compose provides redis:7-alpine.
REDIS_URL=
# Stripe billing. Optional — billing routes return 503 when unconfigured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM_SEAT=
# Sentry error reporting. Optional — disabled when empty.
SENTRY_DSN=
# Dedicated HMAC key for signed compliance exports. Optional — when empty,
# exports are signed with APP_SECRET (legacy). Set it so rotating APP_SECRET
# doesn't break verification of historical exports (openssl rand -hex 32).
AUDIT_EXPORT_KEY=

# Evidence attestation (v3). An Ed25519 key that signs published evidence, so a
# reader can prove WHO issued a record rather than only that it was not edited.
# LEFT EMPTY ON PURPOSE: while empty, evidence publishes and is labelled unsigned.
# Fill it and every new publication is signed; records published before stay
# unsigned, which is the truth about them.
#   Generate: openssl genpkey -algorithm ed25519 -out evidence-signing.pem
#   Then either, for the private half:
#     EVIDENCE_SIGNING_PRIVATE_KEY="$(sed ':a;N;$!ba;s/\n/\\n/g' evidence-signing.pem)"
#     EVIDENCE_SIGNING_PRIVATE_KEY="$(base64 < evidence-signing.pem | tr -d '\n')"
#   Publish the PUBLIC half so buyers can pin it:
#     openssl pkey -in evidence-signing.pem -pubout -out evidence-signing.pub
# KEEP THE PRIVATE HALF OUT OF THIS FILE ON DISK AND OUT OF GIT. It never goes in a
# database row or a log line. Rotation is a new keyId, not an edit to history.
EVIDENCE_SIGNING_PRIVATE_KEY=
EVIDENCE_SIGNING_KEY_ID=deewaanai-platform-2026-1

# ─── Required in production (app refuses to boot without them) ───
# Encryption keys for pipeline prompts and marketplace content.
# Generate with: openssl rand -hex 32  (use a different value for each)
AI_SWARM_MASTER_KEY=
MARKETPLACE_MASTER_KEY=

# ─── User uploads (feedback screenshots) ───
# Default: local disk (dev/beta). Cloud hosts wipe local disk on redeploy —
# set these to move uploads to any S3-compatible object storage (AWS S3,
# Cloudflare R2, MinIO). Objects stay PRIVATE; the app proxies reads/writes.
# All three of BUCKET/KEY/SECRET must be set to activate; unset = disk.
S3_ENDPOINT=            # empty = AWS S3; set for R2/MinIO (e.g. https://<acct>.r2.cloudflarestorage.com)
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: username that is always promoted to admin on signup/login.
# The very first user becomes admin automatically even without this.
AUTO_ADMIN_USERNAME=

# ─── Scheduled DB backups (Batch A) ───
# Bearer token authorizing POST /api/admin/backup (called by the GitHub
# Actions cron in .github/workflows/backup.yml — add the same value as the
# BACKUP_TOKEN repository secret). Dumps are gzipped and uploaded to the S3
# bucket above under backups/ with 7-day retention; empty = endpoint 503s.
# Generate with: openssl rand -hex 32
BACKUP_TOKEN=

# Trusted proxy mode (default true). The app assumes a trusted edge proxy
# (Railway) sanitizes x-forwarded-for; auth rate limits key off it. Set to
# "false" ONLY if the app is ever exposed directly to the internet with no
# proxy in front — then the direct socket IP is used instead.
TRUSTED_PROXY=

# Public origin of the app, used when building absolute links (spec §0.9b).
# Empty = falls back to the Railway production URL.
PUBLIC_APP_URL=

# CORS origins allowed to call /api/waitlist/* from a browser (the static
# marketing site). Comma-separated. Default "*" is safe (public, unauth,
# cookie-free); set the site domain once final, e.g. https://deewaanai.com
WAITLIST_CORS_ORIGINS=
