---
// Blog article layout: Base + title/date header + prose body + back link.
import Base from "./Base.astro";
import { getUiStrings } from "../i18n/ui";
import { localePrefix, type Locale } from "../i18n/locales";

interface Props {
  title: string;
  description: string;
  path: string;             // unprefixed, e.g. "/blog/my-post"
  date: Date;
  jsonLd?: Record<string, unknown>;
  locale: Locale;
  translated?: boolean;
}
const { title, description, path, date, jsonLd, locale, translated = true } = Astro.props;
const { strings: s } = getUiStrings(locale);
const p = localePrefix(locale);
---
<Base title={`${title} — DeeWaanAI`} description={description} path={path} ogType="article" jsonLd={jsonLd} translated={translated} locale={locale}>
  <article class="py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <a href={`${p}/blog`} class="text-sm text-accent underline-offset-4 hover:underline">{s.blog.backToBlog}</a>
        <h1 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
        <time datetime={date.toISOString()} class="mt-3 block text-sm text-neutral-400">
          {date.toLocaleDateString(locale === "en" ? "en-GB" : locale, { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <div class="prose-docs mt-8">
          <slot />
        </div>
      </div>
    </div>
  </article>
</Base>
