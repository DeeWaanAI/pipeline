---
// Docs layout: left sidebar nav (all manual pages, ordered), prose content,
// "on this page" anchors, chained Next link, TechArticle JSON-LD (SPEC §5.4).
import Base from "./Base.astro";
import { getUiStrings } from "../i18n/ui";
import { localePrefix, type Locale } from "../i18n/locales";

export interface DocsNavItem { slug: string; title: string }
export interface DocsHeading { depth: number; slug: string; text: string }

interface Props {
  title: string;
  description: string;
  path: string;                    // unprefixed, e.g. "/docs/selling"
  locale: Locale;
  translated?: boolean;
  nav: DocsNavItem[];              // ordered sidebar items ("index" = /docs)
  currentSlug: string;
  headings: DocsHeading[];         // markdown headings (h2) for "on this page"
  next?: DocsNavItem;              // chained footer link
  jsonLd?: Record<string, unknown>;
}
const { title, description, path, locale, translated = true, nav, currentSlug, headings, next, jsonLd } = Astro.props;
const { strings: s } = getUiStrings(locale);
const p = localePrefix(locale);
const hrefFor = (slug: string) => (slug === "index" ? `${p}/docs` : `${p}/docs/${slug}`);
---
<Base title={`${title} — DeeWaanAI`} description={description} path={path} jsonLd={jsonLd} translated={translated} locale={locale}>
  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[220px_minmax(0,1fr)_180px]">
      {/* Sidebar */}
      <nav aria-label={s.docsNav.docsHome} class="lg:sticky lg:top-20 lg:self-start">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-neutral-400">{s.docsNav.docsHome}</h2>
        <ul class="flex flex-wrap gap-x-4 gap-y-1.5 lg:flex-col lg:gap-x-0">
          {nav.map((item) => (
            <li>
              <a
                href={hrefFor(item.slug)}
                aria-current={item.slug === currentSlug ? "page" : undefined}
                class:list={[
                  "block rounded-md px-2 py-1.5 text-sm transition",
                  item.slug === currentSlug
                    ? "bg-accent/10 font-medium text-accent"
                    : "text-neutral-400 hover:text-white",
                ]}
              >{item.title}</a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Content */}
      <article class="prose-docs min-w-0">
        <h1 class="!mb-2 !mt-0 text-3xl font-bold text-white">{title}</h1>
        <slot />
        {next && (
          <p class="mt-14 border-t border-ink-800 pt-6">
            <a href={hrefFor(next.slug)} class="font-medium">{s.docsNav.nextTemplate.replace("{title}", next.title)}</a>
          </p>
        )}
      </article>

      {/* On this page */}
      {headings.length > 0 && (
        <nav aria-label={s.docsNav.onThisPage} class="hidden lg:sticky lg:top-20 lg:block lg:self-start">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-neutral-400">{s.docsNav.onThisPage}</h2>
          <ul class="space-y-1.5">
            {headings.map((h) => (
              <li><a href={`#${h.slug}`} class="text-xs text-neutral-400 transition hover:text-accent">{h.text}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </div>
</Base>
