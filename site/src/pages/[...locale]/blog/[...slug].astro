---
// /blog/<slug> — one static path per (locale × post). Missing translations
// render the EN post with the fallback note (never a 404). Article JSON-LD.
import { render } from "astro:content";
import Article from "../../../layouts/Article.astro";
import { LOCALES, DEFAULT_LOCALE, localePrefix, type Locale } from "../../../i18n/locales";
import { blogForLocale } from "../../../i18n/content";

export async function getStaticPaths() {
  const out = [];
  for (const locale of LOCALES) {
    for (const { slug, entry, translated } of await blogForLocale(locale)) {
      out.push({
        params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug },
        props: { entry, locale, translated },
      });
    }
  }
  return out;
}

const { entry, locale, translated } = Astro.props as {
  entry: Parameters<typeof render>[0];
  locale: Locale;
  translated: boolean;
};
const { Content } = await render(entry);
const origin = Astro.site?.origin ?? "";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  author: { "@type": "Organization", name: "DeeWaanAI" },
  mainEntityOfPage: `${origin}${localePrefix(locale)}/blog/${Astro.params.slug}`,
};
---
<Article
  title={entry.data.title}
  description={entry.data.description}
  path={`/blog/${Astro.params.slug}`}
  date={entry.data.date}
  jsonLd={jsonLd}
  locale={locale}
  translated={translated}
>
  <Content />
</Article>
