---
// /blog — post index (SPEC §5 /blog). Locale-scoped with EN fallback.
import Base from "../../../layouts/Base.astro";
import { getUiStrings } from "../../../i18n/ui";
import { isLocale, DEFAULT_LOCALE, localePrefix, type Locale } from "../../../i18n/locales";
import { localeStaticPaths } from "../../../i18n/paths";
import { blogForLocale } from "../../../i18n/content";

export const getStaticPaths = localeStaticPaths;

const locale: Locale = isLocale(Astro.params.locale) ? Astro.params.locale : DEFAULT_LOCALE;
const { strings: s, translated } = getUiStrings(locale);
const p = localePrefix(locale);
const posts = (await blogForLocale(locale)).sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
---
<Base title={s.blog.metaTitle} description={s.blog.metaDescription} path="/blog" translated={translated} locale={locale}>
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <h1 class="text-3xl font-bold text-white sm:text-4xl">{s.blog.title}</h1>
        {posts.length === 0 ? (
          <p class="mt-6 text-neutral-400">{s.blog.empty}</p>
        ) : (
          <ul class="mt-10 space-y-6">
            {posts.map(({ slug, entry }) => (
              <li>
                <article class="card transition hover:border-accent/40">
                  <a href={`${p}/blog/${slug}`} class="block">
                    <h2 class="text-lg font-semibold text-white">{entry.data.title}</h2>
                    <time datetime={entry.data.date.toISOString()} class="mt-1 block text-xs text-neutral-400">
                      {entry.data.date.toLocaleDateString(locale === "en" ? "en-GB" : locale, { year: "numeric", month: "long", day: "numeric" })}
                    </time>
                    <p class="mt-2 text-sm leading-6 text-neutral-400">{entry.data.description}</p>
                    <span class="mt-3 inline-block text-sm text-accent">{s.blog.readMore}</span>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</Base>
