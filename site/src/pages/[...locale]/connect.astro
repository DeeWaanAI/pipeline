---
// /connect — per-client setup guides (SPEC §5 /connect). MCP URL in a
// copyable code block (tiny copy script — within the near-zero JS budget),
// one native <details> per client, CTA back to the waitlist.
import Base from "../../layouts/Base.astro";
import { getUiStrings } from "../../i18n/ui";
import { isLocale, DEFAULT_LOCALE, localePrefix, type Locale } from "../../i18n/locales";
import { localeStaticPaths } from "../../i18n/paths";
import { LOCAL_MCP_URL } from "../../config";

export const getStaticPaths = localeStaticPaths;

const locale: Locale = isLocale(Astro.params.locale) ? Astro.params.locale : DEFAULT_LOCALE;
const { strings: s, translated } = getUiStrings(locale);
const p = localePrefix(locale);
const c = s.connect;
---
<Base title={c.metaTitle} description={c.metaDescription} path="/connect" translated={translated} locale={locale}>
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <h1 class="text-3xl font-bold text-white sm:text-4xl">{c.title}</h1>
        <p class="mt-4 text-neutral-400">{c.intro}</p>

        <details class="group mt-8 rounded-xl border border-accent/30 bg-ink-900 px-5 py-4" open>
          <summary class="cursor-pointer list-none text-sm font-semibold text-neutral-100 marker:hidden">
            <span class="inline-flex w-full items-center justify-between gap-4">
              {c.install.title}
              <svg class="h-4 w-4 shrink-0 text-neutral-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <ol class="mt-4 list-decimal space-y-2 ps-5 text-sm leading-6 text-neutral-400">
            {c.install.steps.map((step) => <li>{step}</li>)}
          </ol>
        </details>

        <div class="mt-8">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">{c.urlLabel}</span>
          <div class="mt-2 flex items-center gap-2">
            <code id="mcp-url" class="flex-1 overflow-x-auto whitespace-nowrap rounded-lg border border-ink-700 bg-ink-900 px-4 py-3 font-mono text-sm text-accent-soft">{LOCAL_MCP_URL}</code>
            <button id="mcp-copy" class="btn-ghost !px-4 !py-3 text-xs" data-label={c.copy}>{c.copy}</button>
          </div>
        </div>

        <div class="mt-10 space-y-3">
          {c.clients.map((client) => (
            <details class="group rounded-xl border border-ink-700 bg-ink-900 px-5 py-4">
              <summary class="cursor-pointer list-none text-sm font-semibold text-neutral-100 marker:hidden">
                <span class="inline-flex w-full items-center justify-between gap-4">
                  {client.name}
                  <svg class="h-4 w-4 shrink-0 text-neutral-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <ol class="mt-4 list-decimal space-y-2 ps-5 text-sm leading-6 text-neutral-400">
                {client.steps.map((step) => <li>{step}</li>)}
              </ol>
            </details>
          ))}
        </div>

        <p class="mt-12 text-center">
          <a href={`${p}/docs`} class="btn-accent">{c.cta}</a>
        </p>
      </div>
    </div>
  </section>
  <script define:vars={{ copied: c.copied, copy: c.copy }}>
    const btn = document.getElementById("mcp-copy");
    btn?.addEventListener("click", async () => {
      const url = document.getElementById("mcp-url")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = copied;
        setTimeout(() => { btn.textContent = copy; }, 2000);
      } catch { /* clipboard unavailable — URL stays visible for manual copy */ }
    });
  </script>
</Base>
