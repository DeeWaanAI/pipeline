---
// Landing page (SPEC §4, section by section). All copy comes from the
// per-locale string bundle; JSON-LD: Organization + SoftwareApplication +
// FAQPage (built from the same FAQ strings — single source of truth).
import Base from "../../layouts/Base.astro";
import WaitlistSection from "../../components/landing/WaitlistSection.astro";
import { getUiStrings } from "../../i18n/ui";
import { isLocale, DEFAULT_LOCALE, localePrefix, type Locale } from "../../i18n/locales";
import { localeStaticPaths } from "../../i18n/paths";

export const getStaticPaths = localeStaticPaths;

const locale: Locale = isLocale(Astro.params.locale) ? Astro.params.locale : DEFAULT_LOCALE;
const { strings: s, translated } = getUiStrings(locale);
const p = localePrefix(locale);
const l = s.landing;
const origin = Astro.site?.origin ?? "";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "DeeWaanAI",
    url: `${origin}${p}/`,
    description: l.hero.subline,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "DeeWaanAI",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any (MCP-compatible chat client)",
    url: `${origin}${p}/`,
    description: l.hero.subline,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD", description: "Free during beta; one flat $9.99 monthly subscription at launch" },
    featureList: [
      ...l.capabilities.plan.features,
      ...l.betaFeatures.items.map((f) => f.title),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: l.faq.items.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<Base
  title={l.metaTitle}
  description={l.metaDescription}
  path="/"
  jsonLd={jsonLd}
  translated={translated}
  locale={locale}
>
  {/* ── 4.2 Hero ── */}
  <section class="py-20 sm:py-28">
    <div class="container-page text-center">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
        {l.hero.title}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-400">{l.hero.subline}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#waitlist" class="btn-accent">{l.hero.primaryCta}</a>
        <a href="#how-it-works" class="btn-ghost">{l.hero.secondaryCta}</a>
      </div>
      {/* Demo video slot — /media/demo.mp4 added later; styled placeholder meanwhile */}
      <figure class="mx-auto mt-14 max-w-3xl">
        <div class="relative aspect-video overflow-hidden rounded-xl border border-ink-700 bg-ink-900">
          <video id="demo-video" class="h-full w-full" controls preload="none" poster="">
            <source src="/media/demo.mp4" type="video/mp4" />
          </video>
          <div id="demo-placeholder" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-ink-900">
            <div class="flex h-16 w-16 items-center justify-center rounded-full border border-accent/40 bg-accent/10">
              <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5z" />
              </svg>
            </div>
            <span class="text-sm text-neutral-400">{l.hero.videoPlaceholder}</span>
          </div>
        </div>
        <figcaption class="mt-3 text-xs text-neutral-400">{l.hero.videoCaption}</figcaption>
      </figure>
      <script>
        // Hide the placeholder only if the demo file actually loads.
        const v = document.getElementById("demo-video") as HTMLVideoElement | null;
        v?.addEventListener("loadeddata", () => {
          document.getElementById("demo-placeholder")?.classList.add("hidden");
        });
      </script>
    </div>
  </section>

  {/* ── 4.3 Works-with strip ── */}
  <section class="border-t border-ink-800 py-10" aria-label={l.worksWith.label}>
    <div class="container-page text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400">{l.worksWith.label}</p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        {l.worksWith.badges.map((b) => (
          <span class="rounded-full border border-ink-700 bg-ink-900 px-4 py-1.5 text-sm font-medium text-neutral-300">{b}</span>
        ))}
      </div>
      <p class="mt-4 text-xs text-neutral-400">{l.worksWith.caption}</p>
    </div>
  </section>

  {/* ── Problem ── */}
  <section id="problem" aria-labelledby="problem-title" class="border-t border-ink-800 py-20">
    <div class="container-page">
      <h2 id="problem-title" class="text-center text-3xl font-bold text-white">{l.problem.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-neutral-400">{l.problem.intro}</p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {l.problem.items.map((item) => (
          <article class="card">
            <h3 class="text-lg font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-neutral-400">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── 4.4 How it works ── */}
  <section id="how-it-works" aria-labelledby="hiw-title" class="border-t border-ink-800 py-20">
    <div class="container-page">
      <h2 id="hiw-title" class="text-center text-3xl font-bold text-white">{l.howItWorks.title}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {l.howItWorks.steps.map((step, i) => (
          <article class="card">
            <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-3 text-lg font-semibold text-white">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-neutral-400">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── 4.6 Two audiences ── */}
  <section id="for-creators" aria-label="For creators and for users" class="border-t border-ink-800 py-20">
    <div class="container-page grid gap-6 md:grid-cols-2">
      {[l.audiences.creators, l.audiences.users].map((aud) => (
        <article class="card">
          <h3 class="text-xl font-semibold text-white">{aud.title}</h3>
          <p class="mt-1 text-sm text-neutral-400">{aud.subtitle}</p>
          <ul class="mt-4 space-y-2.5">
            {aud.bullets.map((b) => (
              <li class="flex items-start gap-2.5 text-sm text-neutral-300">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {b}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  {/* ── Capabilities (one flat plan — no tier ladder) ── */}
  <section id="capabilities" aria-labelledby="capabilities-title" class="border-t border-ink-800 py-20">
    <div class="container-page">
      <h2 id="capabilities-title" class="text-center text-3xl font-bold text-white">{l.capabilities.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-neutral-400">{l.capabilities.intro}</p>
      <div class="mx-auto mt-12 max-w-2xl">
        <article class="card relative">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-lg font-semibold text-white">{l.capabilities.plan.name}</h3>
            <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">{l.capabilities.plan.badge}</span>
          </div>
          <p class="mt-4 flex flex-wrap items-baseline gap-2">
            <span class="text-4xl font-bold text-white">{l.capabilities.plan.price}</span>
            <span class="text-sm text-neutral-400">{l.capabilities.plan.cadence}</span>
          </p>
          <p class="mt-1 text-sm font-medium text-neutral-300">{l.capabilities.plan.description}</p>
          <ul class="mt-5 grid gap-2 sm:grid-cols-2">
            {l.capabilities.plan.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-neutral-400">
                <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-accent-soft" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-ink-800 pt-4 text-xs text-neutral-500">{l.capabilities.plan.betaNote}</p>
        </article>
      </div>
      <p class="mx-auto mt-6 max-w-xl text-center text-xs text-neutral-500">{l.capabilities.smallPrint}</p>
      <p class="mt-8 text-center">
        <a href="#waitlist" class="btn-accent">{l.capabilities.cta}</a>
      </p>
    </div>
  </section>

  {/* ── Beta Features ── */}
  <section id="beta-features" aria-labelledby="beta-features-title" class="border-t border-ink-800 py-20">
    <div class="container-page">
      <h2 id="beta-features-title" class="text-center text-3xl font-bold text-white">{l.betaFeatures.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-neutral-400">{l.betaFeatures.intro}</p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {l.betaFeatures.items.map((f) => (
          <article class="card">
            <div class="flex items-center gap-2">
              <h3 class="text-base font-semibold text-white">{f.title}</h3>
              <span class="rounded-full border border-accent/30 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent">Beta</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-neutral-400">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── 4.5 Trust section (differentiator — visual weight) ── */}
  <section aria-labelledby="trust-title" class="border-t border-ink-800 bg-ink-900/40 py-20">
    <div class="container-page">
      <h2 id="trust-title" class="text-center text-3xl font-bold text-white">{l.trust.title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-neutral-400">{l.trust.intro}</p>
      <div class="relative mt-12 grid gap-6 md:grid-cols-3">
        {l.trust.layers.map((layer, i) => (
          <article class="card relative border-accent/15">
            <div class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-accent/40 bg-accent/10 font-mono text-sm text-accent">{i + 1}</span>
              <h3 class="text-base font-semibold text-white">{layer.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-6 text-neutral-400">{layer.body}</p>
          </article>
        ))}
      </div>
      <p class="mt-10 text-center text-sm font-medium text-accent-soft">{l.trust.closing}</p>
      <p class="mt-4 text-center">
        <a href={`${p}/trust`} class="text-sm text-accent underline-offset-4 hover:underline">{l.trust.link}</a>
      </p>
    </div>
  </section>

  {/* ── 4.7 Pioneer 100 (conversion engine) ── */}
  <WaitlistSection s={s} />

  {/* ── 4.8 FAQ (native <details> — no JS; doubles as GEO content) ── */}
  <section aria-labelledby="faq-title" class="border-t border-ink-800 py-20">
    <div class="container-page">
      <h2 id="faq-title" class="text-center text-3xl font-bold text-white">{l.faq.title}</h2>
      <div class="mx-auto mt-10 max-w-3xl space-y-3">
        {l.faq.items.map((f) => (
          <details class="group rounded-xl border border-ink-700 bg-ink-900 px-5 py-4">
            <summary class="cursor-pointer list-none text-sm font-semibold text-neutral-100 marker:hidden">
              <span class="inline-flex w-full items-center justify-between gap-4">
                {f.q}
                <svg class="h-4 w-4 shrink-0 text-neutral-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-neutral-400">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
